# Public HTTPS URL of the deployed API. Vite embeds this during the web build.
VITE_API_BASE_URL=https://pragyanta-api.example.com
VITE_MOCK=0
VITE_SHOW_DEMO_SWITCHER=false

# Supplied by the managed PostgreSQL service; never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CORS_ORIGINS=https://pragyanta-web.example.com

# Keyless deterministic mode. Change to 0 only after adding OPENAI_API_KEY as a secret.
MOCK_OPENAI=1
