{
  "_readme": "Golden set for eval_tutor.py (spec §12.3). Run against the seed lesson 'Python Lists and Tuples'. Each case: student_message, context ('fresh' = new session, 'after_remediation' = an open mutability misconception exists and last tutor msg was the verification question 'You have point = (3, 4). What happens if you run point[0] = 5?'), expected_intent, expect_misconception, expect_grounded. Sid: refine wording, add cases from real testing. Target >= 90% before UI polish.",
  "cases": [
    {"id": 1, "context": "fresh", "student_message": "What's the difference between a list and a tuple?", "expected_intent": "question", "expect_misconception": false, "expect_grounded": true, "note": "baseline grounded QA with citation"},
    {"id": 2, "context": "fresh", "student_message": "A tuple is better because we can modify its values later.", "expected_intent": "answer_attempt", "expect_misconception": true, "expect_grounded": true, "note": "demo misconception"},
    {"id": 3, "context": "fresh", "student_message": "Tuples can be changed whenever you want, right?", "expected_intent": "answer_attempt", "expect_misconception": true, "expect_grounded": true, "note": "casual reversed mutability"},
    {"id": 4, "context": "fresh", "student_message": "I'd use a tuple for a shopping cart since I can keep appending items to it.", "expected_intent": "answer_attempt", "expect_misconception": true, "expect_grounded": true, "note": "wrong use case"},
    {"id": 5, "context": "fresh", "student_message": "Lists are immutable so they're safer for coordinates.", "expected_intent": "answer_attempt", "expect_misconception": true, "expect_grounded": true, "note": "reversed other direction"},
    {"id": 6, "context": "fresh", "student_message": "If I do point[0] = 5 on a tuple it just updates the first value.", "expected_intent": "answer_attempt", "expect_misconception": true, "expect_grounded": true, "note": "wrong concrete code claim"},
    {"id": 7, "context": "fresh", "student_message": "You can use a list as a dictionary key as long as it's short.", "expected_intent": "answer_attempt", "expect_misconception": true, "expect_grounded": true, "note": "hashability misconception"},
    {"id": 8, "context": "fresh", "student_message": "Tuples are slower than lists because immutability adds overhead.", "expected_intent": "answer_attempt", "expect_misconception": true, "expect_grounded": true, "note": "performance reversed"},
    {"id": 9, "context": "fresh", "student_message": "sort() works the same on tuples and lists.", "expected_intent": "answer_attempt", "expect_misconception": true, "expect_grounded": true, "note": "mutating method on tuple"},
    {"id": 10, "context": "fresh", "student_message": "A tuple is immutable, so once it's created its values are fixed.", "expected_intent": "answer_attempt", "expect_misconception": false, "expect_grounded": true, "note": "false-positive trap"},
    {"id": 11, "context": "fresh", "student_message": "I'd pick a list for the shopping cart because I need to add and remove items.", "expected_intent": "answer_attempt", "expect_misconception": false, "expect_grounded": true, "note": "correct use case"},
    {"id": 12, "context": "fresh", "student_message": "For coordinates I'd use a tuple, and honestly lists feel messier to me anyway.", "expected_intent": "answer_attempt", "expect_misconception": false, "expect_grounded": true, "note": "correct plus opinion"},
    {"id": 13, "context": "fresh", "student_message": "You can convert a list to a tuple with tuple() and it makes a new object.", "expected_intent": "answer_attempt", "expect_misconception": false, "expect_grounded": true, "note": "correct conversion"},
    {"id": 14, "context": "fresh", "student_message": "x, y = (3, 4) puts 3 in x and 4 in y.", "expected_intent": "answer_attempt", "expect_misconception": false, "expect_grounded": true, "note": "correct unpacking"},
    {"id": 15, "context": "fresh", "student_message": "Who won the cricket world cup?", "expected_intent": "off_topic", "expect_misconception": false, "expect_grounded": false, "note": "grounding trap"},
    {"id": 16, "context": "fresh", "student_message": "How do Python dictionaries handle hash collisions internally?", "expected_intent": "off_topic", "expect_misconception": false, "expect_grounded": false, "note": "adjacent but uncovered"},
    {"id": 17, "context": "fresh", "student_message": "Can you write me a full Python program for a to-do app?", "expected_intent": "off_topic", "expect_misconception": false, "expect_grounded": false, "note": "outside task"},
    {"id": 18, "context": "fresh", "student_message": "What does the lesson say about sets?", "expected_intent": "question", "expect_misconception": false, "expect_grounded": false, "note": "grounding edge"},
    {"id": 19, "context": "after_remediation", "student_message": "It will throw an error because tuples can't be changed after creation.", "expected_intent": "verification_response", "expect_misconception": false, "expect_grounded": true, "expected_verdict": "resolved", "note": "genuine understanding"},
    {"id": 20, "context": "after_remediation", "student_message": "A list is like a whiteboard and a tuple is like a printed page.", "expected_intent": "verification_response", "expect_misconception": false, "expect_grounded": true, "expected_verdict": "unresolved", "note": "parrot trap"},
    {"id": 21, "context": "after_remediation", "student_message": "It changes the tuple to (5, 4).", "expected_intent": "verification_response", "expect_misconception": false, "expect_grounded": true, "expected_verdict": "unresolved", "note": "still wrong"},
    {"id": 22, "context": "after_remediation", "student_message": "Python raises a TypeError since tuples don't support item assignment.", "expected_intent": "verification_response", "expect_misconception": false, "expect_grounded": true, "expected_verdict": "resolved", "note": "precise understanding"},
    {"id": 23, "context": "fresh", "student_message": "ok", "expected_intent": "question", "expect_misconception": false, "expect_grounded": true, "note": "ambiguous short response"},
    {"id": 24, "context": "fresh", "student_message": "idk this is confusing", "expected_intent": "question", "expect_misconception": false, "expect_grounded": true, "note": "frustration is not misconception"},
    {"id": 25, "context": "fresh", "student_message": "So lists and tuples are basically the same thing then.", "expected_intent": "answer_attempt", "expect_misconception": true, "expect_grounded": true, "note": "interchangeability misconception"}
  ]
}
